# RFC 5737 documentation-only addresses. Replace both with approved private
# site values before installation. RCH XTools documentation lists Ethernet
# port 23 for Print! F, but that does not establish TCP, raw-stream, or Telnet
# semantics.
LISTEN_IP=192.0.2.231
LISTEN_PORT=23
PRINTER_IP=192.0.2.251
PRINTER_PORT=23

OUTPUT_DIR=/var/lib/commercialrchproxy/jobs
LOG_DIR=/var/log/commercialrchproxy

CONNECTION_TIMEOUT_SEC=30
RESPONSE_TIMEOUT_SEC=10
JOB_IDLE_TIMEOUT_MS=1000

SAVE_RAW=true
SAVE_TECHNICAL_TXT=true
SAVE_CLEAN_TXT=true
SAVE_PDF=true
SAVE_JSON=true
HASH_ALGORITHM=sha256

DEBUG=false
DEBUG_HEXDUMP=false
DEBUG_PCAP=false
LOG_PAYLOAD=false
LOG_LEVEL=INFO

RETENTION_DAYS=0
MAX_PAYLOAD_BYTES=67108864
RENDERER_PAPER_WIDTH_MM=79.5
RENDERER_CHARACTERS_PER_LINE=48
SHUTDOWN_GRACE_SEC=15

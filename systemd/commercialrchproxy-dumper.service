[Unit]
Description=commercialRCHproxy full-duplex relay and RAW spool dumper
Documentation=https://github.com/okno/commercialRCHproxy/blob/main/docs/SYSTEMD.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=commercialrchproxy
Group=commercialrchproxy
UMask=0027
# install.sh renders this default from configured OUTPUT_DIR.
WorkingDirectory=/var/lib/commercialrchproxy/jobs
Environment=PYTHONUNBUFFERED=1
Environment=COMMERCIALRCHPROXY_CONFIG=/etc/commercialrchproxy/commercialrchproxy.conf
SyslogIdentifier=commercialrchproxy-dumper
StandardOutput=journal
StandardError=journal
ExecStartPre=/opt/commercialrchproxy/current/venv/bin/commercialrchproxy-dumper --config /etc/commercialrchproxy/commercialrchproxy.conf --check-config --json
ExecStart=/opt/commercialrchproxy/current/venv/bin/commercialrchproxy-dumper --config /etc/commercialrchproxy/commercialrchproxy.conf
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=mixed

# The configured listener may be below 1024.  No other capability is granted.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Configuration and application code are read-only.  The dumper may publish
# completed RAW jobs and its component log, but cannot write elsewhere on the
# host filesystem through this mount namespace.
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/commercialrchproxy /opt/commercialrchproxy
# install.sh renders both paths from configured OUTPUT_DIR and LOG_DIR.
ReadWritePaths=/var/lib/commercialrchproxy/jobs /var/log/commercialrchproxy
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
DevicePolicy=closed
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=4096
TasksMax=64

[Install]
WantedBy=multi-user.target

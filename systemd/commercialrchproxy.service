[Unit]
Description=commercialRCHproxy legacy compatibility launcher
Documentation=https://github.com/okno/commercialRCHproxy/blob/main/docs/SYSTEMD.md
Requires=commercialrchproxy-dumper.service commercialrchproxy-parser.service
# Starting the legacy name orders this no-op after the optional secondary-IP
# drop-in and before both real services.  Direct service starts remain fully
# independent and do not involve this compatibility unit.
Before=commercialrchproxy-dumper.service commercialrchproxy-parser.service
PropagatesStopTo=commercialrchproxy-dumper.service commercialrchproxy-parser.service

[Service]
Type=oneshot
User=commercialrchproxy
Group=commercialrchproxy
ExecStart=/usr/bin/true
RemainAfterExit=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
